 &filelist
   base_filename = 'output/MHD3A_l6t9/MHD3A_l6t9'
   autoconvert   = .true.
   convert_type  = 'vtuBCCmpi'
   saveprim      = .true.
   nwauxio       = 1
 /

 &usr_list
   rho_cl = 1.0d0
   rho_w  = 1.0d-2
   B0uG   = 3d0
   Bdir   = 1
 /

 &savelist
   itsave(1,1) = 0
   itsave(1,2) = 0
   dtsave      = 0.5d0, 0.5d0
 /

 &stoplist
   time_max    = 9.0d0
   dtmin       = 1.0d-10
 /

 &methodlist
   time_stepper = 'twostep'
   flux_scheme     = 20*'hlld'
   typeboundspeed  = 'cmaxleftright'
   fix_small_values = .true.
   small_values_method = 'replace'
   small_pressure = 1.d-8
   small_density  = 5.d-5
 /

 &boundlist
   typeboundary_min1 = 8*'special'
   typeboundary_max1 = 8*'cont'
   typeboundary_min2 = 8*'cont'
   typeboundary_max2 = 8*'cont'
   typeboundary_min3 = 8*'cont'
   typeboundary_max3 = 8*'cont'
 /

 &meshlist
   refine_criterion = 1
   refine_max_level = 6
   max_blocks = 2000
   block_nx1  = 8
   block_nx2  = 8
   block_nx3  = 8
   domain_nx1 = 64
   domain_nx2 = 64
   domain_nx3 = 64
   xprobmin1  = 0.d0
   xprobmax1  = 65.d0
   xprobmin2  = 0.d0
   xprobmax2  = 65.d0
   xprobmin3  = 0.d0
   xprobmax3  = 65.d0
 /

 &paramlist
   slowsteps=100
   typecourant='maxsum'
   courantpar=0.4d0
 /

 &mhd_list
  mhd_radiative_cooling=.true.
  mhd_n_tracer = 1
  typedivbfix = 'ct'
  type_ct = 'uct_contact'
/

 &rc_list
  coolcurve = 'SPEX_DM'
  Tfix=.true.
  tlow = 1.d-5
 /
